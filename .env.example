# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file.

# LLM provider used for intent understanding / planning.
# Leave LLM_API_KEY empty to run SHADOW in rule-based mode (no LLM required).
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Voice
VOICE_ENABLED=false
WAKE_WORD=hey shadow

# Safety
CONFIRM_MEDIUM_RISK=false
MAX_PLAN_STEPS=25
MAX_STEP_RETRIES=1
